# Paisa Wallet Environment Variables Configuration Template
# Duplicate this file to .env and configure values for your environment.

# Flask Application Secret Key (Required for sessions and CSRF tokens)
SECRET_KEY=generate-a-32-byte-random-secret-and-set-it-here

# Database Connection URL
# Local SQLite default:
DATABASE_URL=sqlite:///instance/paisa_wallet.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@hostname:5432/paisa_wallet_db

# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py

# Rate Limiting Storage (default: memory://, production: redis://localhost:6379/0)
RATELIMIT_STORAGE_URI=memory://

# Number of trusted reverse proxies in front of the app. Keep 0 unless configured.
TRUSTED_PROXY_HOPS=0
